/* 1. MotorTask : 바퀴 및 청소 모터 제어 */
void StartMotorTask(void *argument)
{
  for(;;)
  {
    // 장애물 감지 시 회피
    if (g_obstacle_detected) {
        UART_Printf("[Motor] Obstacle Detected! Avoiding...\r\n");
        stop_all_motors();
        osDelay(100);

        // 회피 기동
        move_backward_pwm(BASE_SPEED);
        osDelay(500);

        rotate_right_inplace(TURN_SPEED);
        osDelay(TURN_90_TIME_MS);

        stop_all_motors();
        osDelay(100);

        g_obstacle_detected = 0; // 상황 해제
    }
    else {
        // 평상시 주행
        if (g_powerOn) {
             move_forward_pwm(BASE_SPEED);
             clean_go_pwm(g_target_suction_pwm); // AI가 정한 흡입력
        } else {
             stop_all_motors();
        }
    }
    osDelay(10); // 10ms 주기
  }
}

/* 2. SensorTask : 초음파 센서 측정 */
void StartSensorTask(void *argument)
{
  for(;;)
  {
    // main.h에 정의된 핀 매크로 사용 (TRIG_PIN 등)
    // 에러나면 main.h 열어서 핀 이름 확인하세요!
    float d1 = HCSR04_Read(TRIG_PORT, TRIG_PIN, ECHO_PORT, ECHO_PIN);
    osDelay(10);
    float d2 = HCSR04_Read(TRIG_PORT1, TRIG_PIN1, ECHO_PORT1, ECHO_PIN1);
    osDelay(10);
    float d3 = HCSR04_Read(TRIG_PORT2, TRIG_PIN2, ECHO_PORT2, ECHO_PIN2);

    // 거리값 갱신
    g_d1 = d1; g_d2 = d2; g_d3 = d3;

    // 장애물 판단 (30cm 이내)
    if ((d1 > 1.0f && d1 < 30.0f) ||
        (d2 > 1.0f && d2 < 30.0f) ||
        (d3 > 1.0f && d3 < 30.0f))
    {
        g_obstacle_detected = 1;
    }

    osDelay(50);
  }
}

/* 3. CommTask : 통신 */
void StartCommTask(void *argument)
{
  osDelay(1000); // 부팅 대기

  // WizFi 초기화
  UART_Printf("[Comm] Init WizFi360...\r\n");
  MQTT_Init_All(&huart3, &huart2);

  for(;;)
  {
    Publish_Message();
    osDelay(1000); // 1초마다 전송
  }
}

/* 4. AITask : 인공지능 */
void StartAITask(void *argument)
{
  // 타이머 시작 (인터럽트)
  HAL_TIM_Base_Start_IT(&htim6);

  for(;;)
  {
    if (edge_ai_buffer_ready) {
        UART_Printf("[AI] Inferencing...\r\n");

        // --- [AI 추론 로직] ---
        // (여기서 노면 판별 후 g_target_suction_pwm 값 변경)
        // 예: g_target_suction_pwm = 900;

        edge_ai_buffer_ready = 0;
    }

    osDelay(50);
  }
}

